# Keep a recognizable ABI so fallback entries cannot be confused with stock.
CONFIG_LOCALVERSION="-glymur-a14"
CONFIG_LOCALVERSION_AUTO=n

# UEFI and initramfs are required by the Omarchy live image and installed boot.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_ZBOOT=y
CONFIG_BLK_DEV_INITRD=y

# linux-firmware packages Qualcomm GPU and Bluetooth blobs with zstd. Loading
# them directly avoids duplicating raw blobs in every versioned namespace.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# The Omarchy ISO uses a zstd-compressed SquashFS root and an overlay.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y

# Keep the root disk and common installed filesystems available during boot.
CONFIG_BLK_DEV_NVME=y
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y

# Quattro supports encrypted installs; these can be modules in the initramfs.
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m
CONFIG_CRYPTO_XTS=m

# Qualcomm's laptop recipe calls this out for M.2 power sequencing.
CONFIG_POWER_SEQUENCING_PCIE_M2=m

# The branch carries an EC driver with an exact UX3407NA compatible. The
# current DTS does not instantiate it yet, but shipping the module lets a
# reviewed DT overlay enable fan/temperature/event support without a rebuild.
CONFIG_EC_ASUS_GLYMUR=m

# A USB Ethernet adapter is the recovery network path if QCC2072 Wi-Fi needs
# board-data debugging. Cover Realtek, ASIX, and standards-based USB-C NICs.
CONFIG_USB_RTL8152=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDC_NCM=m

# QCC2072 can expose Bluetooth over USB on M.2 modules. The branch contains
# the new Qualcomm transport code, although matching USB firmware is not yet
# present in the pinned upstream linux-firmware snapshot.
CONFIG_BT=m
CONFIG_BT_QCA=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIUART=m

# Preserve Qualcomm's complete userspace-to-CDSP path. Firmware and an NPU
# runtime are still required, but omitting FastRPC here would guarantee that
# no future userspace package can reach the Hexagon compute DSP.
CONFIG_QCOM_FASTRPC=m
CONFIG_QCOM_Q6V5_PAS=m

# UX3407NA is sold with a firmware TPM, but ASUS has not documented which Arm
# transport its production firmware exposes to Linux. Build every applicable
# in-tree transport so arrival-day diagnostics can discover CRB/SMC, FF-A, or
# OP-TEE without another kernel rebuild. Built-ins also make the TPM available
# early enough for measured boot and encrypted-root key enrollment.
CONFIG_ARM_FFA_TRANSPORT=y
CONFIG_TCG_TPM=y
CONFIG_TCG_CRB=y
CONFIG_TCG_ARM_CRB_FFA=y
CONFIG_TCG_FTPM_TEE=y
# The Omarchy live image is an ISO9660 filesystem even when written to a USB
# partition. Build this in so the initramfs can mount OMA_SNAP before modules
# or the live root are available.
CONFIG_ISO9660_FS=y
