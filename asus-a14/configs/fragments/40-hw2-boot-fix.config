# Boot services: UFW, Docker, and Tailscale need nftables, NAT, and policy routing.
CONFIG_LOCALVERSION="-zenbook-hw2"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_ARP=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_NAT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP6_NF_IPTABLES=m
# Include zram in this release instead of relying on the running-kernel add-on.
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
# Enable libcamera's software ISP DMA-buf allocator.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=m
# The onboard QCC2072 is a UART Bluetooth controller; restore general
# Bluetooth profiles and the ASUS HID keyboard driver used by the stock boot.
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_HID_ASUS=m
