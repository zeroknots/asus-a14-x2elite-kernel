# hw4: applied on top of zenbook-hw3.
CONFIG_LOCALVERSION="-zenbook-hw4"
CONFIG_LOCALVERSION_AUTO=n
# Firmware TPM: the qcom.tz.tpm QSEECOM app (see tpm_qcom_qsee).
CONFIG_TCG_QCOM_TPM_QSEE=m
# FIDO2 security keys and Bluetooth LE HID (keyboards, mice, controllers).
CONFIG_HIDRAW=y
CONFIG_UHID=m
# Common input devices.
CONFIG_HID_APPLE=m
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_LOGITECH_HIDPP=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_NINTENDO=m
CONFIG_HID_SONY=m
CONFIG_HID_STEAM=m
CONFIG_INPUT_JOYDEV=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
# Storage and filesystems for removable media and other OSes.
CONFIG_USB_UAS=m
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_UDF_FS=m
CONFIG_NLS_UTF8=m
CONFIG_CIFS=m
CONFIG_CRYPTO_MD4=m
CONFIG_DM_SNAPSHOT=m
CONFIG_DM_THIN_PROVISIONING=m
CONFIG_DM_VERITY=m
CONFIG_USB_PRINTER=m
# VPN and networking.
CONFIG_WIREGUARD=m
CONFIG_NET_SCH_FQ_CODEL=m
CONFIG_NET_SCH_FQ=m
CONFIG_NET_SCH_CAKE=m
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=m
CONFIG_DEFAULT_CUBIC=y
CONFIG_NETFILTER_NETLINK_QUEUE=m
CONFIG_NFT_QUEUE=m
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=m
CONFIG_IP_SET=m
CONFIG_NFT_SOCKET=m
CONFIG_NFT_TPROXY=m
CONFIG_NETFILTER_XT_MATCH_SOCKET=m
CONFIG_PACKET_DIAG=m
CONFIG_UNIX_DIAG=m
CONFIG_NETLINK_DIAG=m
CONFIG_VSOCKETS=m
# iwd (kernel crypto API, PKCS#8 keys for enterprise Wi-Fi).
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m
CONFIG_CRYPTO_USER_API_AEAD=m
CONFIG_PKCS8_PRIVATE_KEY_PARSER=m
# Pressure stall information (systemd-oomd), checkpoint/restore support.
CONFIG_PSI=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_SND_HRTIMER=m
