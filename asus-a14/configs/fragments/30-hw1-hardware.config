CONFIG_LOCALVERSION="-zenbook-hw1"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_TEE=y
CONFIG_QCOMTEE=m
CONFIG_TCG_TPM=y
CONFIG_TCG_QCOM=m
CONFIG_QCOM_FASTRPC=m
CONFIG_DM_INTEGRITY=m
# Keep the configured 16 GiB zstd zram swap available on test kernels.
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
# Native test build: omit large debug sections and the pahole dependency.
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_DEBUG_INFO_BTF_MODULES=n
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
